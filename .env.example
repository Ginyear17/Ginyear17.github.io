# 部署敏感配置：复制为 .env 并修改（.env 已被 gitignore，不会入库）
# docker compose 会自动读取同目录下的 .env
# 生成随机 SECRET_KEY: openssl rand -hex 32

# 会话签名密钥（必须设置随机值！）
SECRET_KEY=请用 openssl rand -hex 32 生成

# 邮箱验证码注册（可选；不配则发送验证码返回 503，其余功能正常）
# QQ 邮箱授权码获取：QQ邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASSWORD=你的QQ邮箱授权码
SMTP_FROM=你的QQ邮箱@qq.com
