# 复制为 .env 后填写，启动命令：uv run uvicorn --env-file .env app.main:app --reload --port 8001

# ===== 会话签名密钥（生产环境务必改成随机长字符串！）=====
SECRET_KEY=dev-secret-change-me

# ===== SMTP 邮件服务（注册验证码）=====
# QQ 邮箱示例：host=smtp.qq.com，port=465，密码填「授权码」（设置→账户→开启SMTP获取）
# 163 邮箱示例：host=smtp.163.com，port=465
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== 开发模式：不发真实邮件，验证码直接随响应返回 =====
# 生产环境务必设为 false 或删除！
SMTP_DEV_MODE=true
